# PostgreSQL Connection URL
# Replace with your actual local or hosted PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resourcehub?schema=public"

# Organization Timezone (Defaults to Asia/Colombo if unset)
ORG_TIMEZONE="Asia/Colombo"

# Authentication Secret (min 32 characters, e.g. generate with: openssl rand -base64 32)
AUTH_SECRET="your-at-least-32-chars-auth-secret-here-12345"

# Node Environment
NODE_ENV="development"
